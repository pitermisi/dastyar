# ==============================================================================
# Instagram AI Dashboard - Environment Variables
# ==============================================================================
# Copy this file to .env and provide your credentials.
# NEVER commit actual secrets or the .env file to version control.

# Meta Developer App Credentials (from https://developers.facebook.com)
META_APP_ID=
META_APP_SECRET=

# Instagram OAuth Redirect URI
# Local dev: http://localhost:3000/api/auth/instagram/callback
# Railway / Production: https://your-railway-app.up.railway.app/api/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# PostgreSQL Database URL (used by Prisma)
# In Railway, this is automatically provided when adding a PostgreSQL plugin.
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=postgresql://user:password@localhost:5432/instagram_dashboard

# Security Secrets
# Minimum 32-character random string used for session tokens and AES-256-GCM token encryption
SESSION_SECRET=change-this-to-a-secure-random-32-character-secret-in-production
ENCRYPTION_KEY=optional-distinct-aes256-key-or-falls-back-to-session-secret

# OAuth Scopes
# Default minimum required permission for Instagram Login
INSTAGRAM_SCOPES=instagram_business_basic

# Node Environment
NODE_ENV=development
